subscription_id = "00000000-0000-0000-0000-000000000000"
# Terraform generates the lab password. Retrieve with: terraform output -raw admin_password

name_prefix = "rsyslog-lab"
location    = "spaincentral"

# scripts/prepare_lab.py discovers sizes, images, zones, and vCPU quota interactively.
# For manual deployment, set only after checking regional availability and quota.
availability_zones = []

# To enable the optional jump host, set this to true and provide your real public CIDR.
enable_jump_host = false
# admin_cidr = "203.0.113.10/32"

tags = {
  owner = "replace-me"
}
